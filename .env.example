# Copy to .env and fill in. Never commit .env.

# development | production   (production hides /docs and requires a strong JWT secret)
CRM_ENV=production

# python -c "import secrets; print(secrets.token_urlsafe(48))"
CRM_JWT_SECRET=
POSTGRES_PASSWORD=

CRM_ACCESS_TOKEN_MINUTES=15
CRM_REFRESH_TOKEN_DAYS=7

# Brute force and rate limiting
CRM_LOGIN_MAX_FAILURES=5
CRM_LOGIN_LOCKOUT_MINUTES=15
CRM_RATE_LIMIT_DEFAULT=120
CRM_RATE_LIMIT_LOGIN=10

# true only when a reverse proxy you control sets X-Forwarded-For
CRM_TRUST_PROXY=false
# true once the API is served over HTTPS
CRM_ENABLE_HSTS=false
# JSON list of allowed browser origins, e.g. ["https://crm.example.com"]
CRM_CORS_ORIGINS=[]

# First admin, used by `python -m scripts.seed`
CRM_ADMIN_EMAIL=admin@example.com
CRM_ADMIN_PASSWORD=
